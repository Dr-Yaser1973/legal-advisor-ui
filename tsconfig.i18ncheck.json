    "components/HeroShowcase.tsx",
    "components/AuthButton.tsx",
    "components/PlatformVisitorsCounter.tsx",
    "components/ui/LanguageSwitcher.tsx",
    "components/library/LibraryTabs.tsx"
  ],
  "exclude": ["node_modules"]
}
