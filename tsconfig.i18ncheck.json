{
  "//": "ملف مؤقت للتحقق من الأنواع في نطاق تعديلات i18n فقط. آمن للحذف.",
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "lib/i18n/**/*.ts",
    "lib/hooks/useLocale.ts",
    "app/page.tsx",
